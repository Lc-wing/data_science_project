{
  "schema_version": "1.0.0",
  "step": "Phase A step 4: panel regression for H1 and H2",
  "role": "ex-post description of the same-month association; not a forecast",
  "frozen_at_utc8": "2026-11-21T12:45:00+08:00",
  "panel_sha256": "9c9547d653c52a168f5b7d8b632458b7d62eece2c0e66c46fcbd8934de479729",
  "analysis_spec_sha256": "347c14d671f53f9ba3fc472cb1eba972b4519c146a920144d9c356a71ca1a4d5",
  "spec_version": "1.0.0",
  "specification": {
    "role": "ex-post description of the same-month association; not a forecast",
    "sample": "main sample: pre-pandemic and post-pandemic months, all four classes",
    "model": "occupancy_pct[i,t] = a[i] + a_post[i]·post[t] + month-of-year[t] + (b[i] + b_post[i]·post[t])·log_visitors_overnight[t] + (c + c_post·post[t])·same_day_share_pct[t] + controls + e[i,t]",
    "terms": {
      "a[i], a_post[i]": "star-class intercepts and their post-pandemic shifts",
      "month-of-year": "eleven calendar-month indicators, common to all classes",
      "b[i], b_post[i]": "class-specific slopes on log overnight visitors",
      "c, c_post": "common slope on the same-day share",
      "controls": [
        "international_share_pct",
        "package_tour_share_pct",
        "log_rooms",
        "cn_holiday_days",
        "typhoon_days"
      ]
    },
    "controls_note": "controls have one coefficient each, common to classes and periods",
    "estimator": "least squares with indicator variables",
    "standard_errors": {
      "type": "Driscoll–Kraay",
      "kernel": "Bartlett",
      "bandwidth_rule": "floor(4 × (T / 100)^(2/9)), T = months in the sample",
      "lag_counting": "in calendar months, so no autocovariance is taken across the gap between December 2019 and January 2023"
    },
    "inference": "two-sided, alpha 0.05, normal reference; 95% CI for every coefficient",
    "confirmatory_tests": {
      "H1": {
        "statement": "after the pandemic, the association between log overnight visitors and occupancy differs between 5-star and 3-star hotels",
        "null": "(b[5star] + b_post[5star]) − (b[3star] + b_post[3star]) = 0"
      },
      "H2": {
        "statement": "the association between the same-day share and occupancy differs between the post-pandemic and the pre-pandemic period",
        "null": "c_post = 0"
      },
      "multiplicity": "Holm over the two tests above"
    },
    "secondary_tests": [
      "equality of the four post-pandemic slopes b[i] + b_post[i] (3 df)",
      "Chow-type test: the five post interactions on the two focal regressors are jointly zero (5 df)"
    ],
    "sensitivity_analyses": {
      "S1_pandemic_included": "add 2020-01 to 2022-12 with their own period indicator, interacted like post",
      "S2_logit_outcome": "outcome logit(occupancy_pct / 100); signs and tests are compared, AIC/BIC are not compared across the two scales",
      "S3_bandwidth": "Driscoll–Kraay bandwidth 2 and 8",
      "S4_trends": "class-specific linear time trends added",
      "S5_fully_interacted": "controls and month indicators also interacted with post"
    },
    "diagnostics": {
      "reported": [
        "Ljung–Box on residuals per star class, lags 12 and 24",
        "Breusch–Pagan test for heteroskedasticity"
      ],
      "rule": "reported only; the model, the standard errors, and the tests are not changed on the basis of a diagnostic p-value"
    }
  },
  "deviations_from_spec": [],
  "left_open_by_the_specification": [
    "Bandwidth is the highest lag with a non-zero Bartlett weight; lag j has weight 1 − j / (bandwidth + 1).",
    "The covariance is scaled by n / (n − k).",
    "Joint tests are Wald tests with a chi-square reference.",
    "S1 uses the bandwidth rule with its own number of months.",
    "S4 trends are linear in calendar time, one per star class.",
    "Ljung–Box is computed per star class and per contiguous block (pre-pandemic, post-pandemic), because the residual series has a 36-month gap.",
    "Breusch–Pagan is the studentised (Koenker) LM test on the regressors of the model."
  ],

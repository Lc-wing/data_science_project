{
  "schema_version": "1.0.0",
  "step": "Phase A step 5: rolling-origin backtest for H3",
  "frozen_at_utc8": "2026-11-21T12:45:00+08:00",
  "panel_sha256": "9c9547d653c52a168f5b7d8b632458b7d62eece2c0e66c46fcbd8934de479729",
  "analysis_spec_sha256": "347c14d671f53f9ba3fc472cb1eba972b4519c146a920144d9c356a71ca1a4d5",
  "spec_version": "1.0.0",
  "specification": {
    "task": "forecast occupancy_pct of month t+1 for each star class from data up to t",
    "horizon_months": 1,
    "test_origins": [
      "2024-07",
      "2026-08"
    ],
    "validation_targets": [
      [
        "2018-01",
        "2019-12"
      ],
      [
        "2023-07",
        "2024-06"
      ]
    ],
    "training_rows": "target months up to the origin in the pre-pandemic and post-pandemic periods; lagged features keep their observed values even when the lagged month is in the pandemic period",
    "leakage_rules": [
      "no variable dated at the target month enters a forecast, except the known calendar features",
      "typhoon days of the target month are never a feature",
      "nothing is scaled, encoded, or selected using rows after the origin",
      "orders and hyperparameters are chosen on validation origins only",
      "each test origin is forecast once, after those choices are fixed"
    ],
    "information_set": "pseudo-out-of-sample: the forecast of month t+1 uses the DSEC values of months up to t as published on the download date. DSEC's publication lag and later revisions are not reproduced, so the errors are not those of a forecast made in real time. The holiday features are the exception: they follow the notices published by the end of month t.",
    "models": {
      "seasonal_naive": "forecast = occupancy of the same month one year earlier",
      "sarimax": {
        "fit": "one model per star class, refit at every origin",
        "pandemic_months": "occupancy of 2020-01 to 2022-12 treated as missing",
        "exogenous": [
          "cn_holiday_days_at_origin",
          "cn_golden_week_days_at_origin"
        ],
        "orders": [
          [
            1,
            0,
            0
          ],
          [
            1,
            0,
            1
          ],
          [
            0,
            1,
            1
          ],
          [
            1,
            1,
            1
          ]
        ],
        "seasonal_orders": [
          [
            0,
            1,
            1,
            12
          ],
          [
            1,
            0,
            0,
            12
          ],
          [
            1,
            0,
            1,
            12
          ]
        ],
        "trend": "constant when no differencing is used, none otherwise",
        "selection": "per star class, lowest validation MAE; a candidate that fails to converge at any validation origin is dropped; ties go to the earlier candidate in the lists above; AIC/BIC are not used because the candidates differ in differencing",
        "fallback": {
          "order": [
            1,
            0,
            0
          ],
          "seasonal_order": [
            0,
            1,
            1,
            12
          ]
        }
      },
      "lightgbm": {
        "fit": "one global model for the four classes, refit at every origin",
        "features": [
          "tier",
          "month",
          "days_in_month",
          "cn_holiday_days_at_origin",
          "cn_golden_week_days_at_origin",
          "occupancy_pct_lag1",
          "occupancy_pct_lag2",
          "occupancy_pct_lag3",
          "occupancy_pct_lag12",
          "log_visitors_overnight_lag1",
          "log_visitors_overnight_lag2",
          "log_visitors_overnight_lag3",
          "log_visitors_overnight_lag12",
          "same_day_share_pct_lag1",
          "same_day_share_pct_lag2",
          "same_day_share_pct_lag3",
          "same_day_share_pct_lag12",
          "international_share_pct_lag1",
          "international_share_pct_lag2",
          "international_share_pct_lag3",
          "international_share_pct_lag12",
          "package_tour_share_pct_lag1",
          "package_tour_share_pct_lag2",
          "package_tour_share_pct_lag3",
          "package_tour_share_pct_lag12",
          "log_rooms_lag1",
          "log_rooms_lag2",
          "log_rooms_lag3",
          "log_rooms_lag12",
          "typhoon_days_lag1",
          "typhoon_days_lag2",
          "typhoon_days_lag3",
          "typhoon_days_lag12"
        ],
        "categorical": [
          "tier"
        ],
        "lags_months": [
          1,
          2,
          3,
          12
        ],
        "lagged_variables": [
          "occupancy_pct",
          "log_visitors_overnight",
          "same_day_share_pct",
          "international_share_pct",
          "package_tour_share_pct",
          "log_rooms",
          "typhoon_days"
        ],
        "known_calendar_features": [
          "month",
          "days_in_month",
          "cn_holiday_days_at_origin",
          "cn_golden_week_days_at_origin"
        ],
        "grid": {
          "num_leaves": [
            4,
            8
          ],
          "min_data_in_leaf": [
            10,
            20
          ],
          "n_estimators": [
            100,
            200,
            400
          ]
        },
        "fixed": {
          "objective": "regression",
          "learning_rate": 0.05,
          "feature_fraction": 0.8,
          "lambda_l2": 1.0,
          "max_depth": -1,
          "seed": 42,
          "deterministic": true,
          "num_threads": 1,
          "verbosity": -1
        },
        "selection": "lowest validation MAE pooled over classes; ties go to the earlier grid point"
      }
    },
    "metrics": {
      "scale": "percentage points of occupancy",
      "reported": [
        "MAE",
        "RMSE",
        "MASE"
      ],
      "by": [
        "each star class",
        "pooled over the four classes"
      ],
      "mase_scale": "per star class, mean absolute 12-month difference of occupancy over months up to 2024-06 for which both the month and the month one year earlier are in the main sample; fixed for all origins"
    },
    "tests": {
      "method": "Diebold–Mariano with the Harvey–Leybourne–Newbold correction",
      "loss": "absolute error",
      "horizon": 1,
      "sides": "two-sided",
      "comparisons": [
        "lightgbm vs seasonal_naive",
        "lightgbm vs sarimax"
      ],
      "units": [
        "each star class",
        "pooled: mean loss over the four classes per origin"
      ],
      "multiplicity": "Holm over all ten tests (2 comparisons × 5 units)",
      "h3_rule": "H3 is supported if LightGBM has the lower pooled test MAE against both baselines and both pooled Holm-adjusted p-values are below 0.05. Otherwise H3 is reported as not supported, with the MAE differences and their 95% CIs."
    },
    "sensitivity_analyses": {
      "F1_logit": "SARIMAX and LightGBM fit on logit(occupancy_pct / 100); forecasts are back-transformed and all metrics are computed in percentage points",
      "F2_pandemic_included": "pandemic-period target months kept in LightGBM training and observed in SARIMAX"
    },
    "shap": {
      "method": "TreeSHAP, tree-path-dependent",
      "model_explained": "the LightGBM model fit at each test origin",
      "rows_explained": "that origin's four test forecasts",
      "background": "the training window of that origin only",
      "output": "the forecast in percentage points",
      "check": "base value + sum of SHAP values equals the forecast within 1e-6",
      "reading": "model behaviour only"
    }
  },
  "deviations_from_spec": [],
  "left_open_by_the_specification": [
    "SARIMAX is statsmodels SARIMAX with the exogenous columns as regressors and SARIMA errors, default starting values, L-BFGS with at most 200 iterations, and stationarity and invertibility enforced. A fit counts as converged when the optimiser says so and the forecast is finite.",
    "Candidates are ordered with the non-seasonal order outside and the seasonal order inside, both as listed in the specification.",
    "At a test origin the forecast of the chosen order is used as it comes; fits that did not converge are counted. If a fit fails or gives no finite forecast, the fallback order is used for that origin and counted.",
    "LightGBM gets force_col_wise = true, which its deterministic mode asks for. Every other parameter not in the specification is the library default.",
    "F1 and F2 choose their own orders and hyperparameters on the validation origins, under their own setting. F1 back-transforms with the inverse logit, without a bias correction; the lagged occupancy features stay in percent.",
    "Pooled MASE is the mean of the scaled absolute errors, each divided by the scale of its star class.",
    "The 95% CI of a loss difference uses the same corrected variance and t distribution as the test.",
    "SHAP values are LightGBM's built-in TreeSHAP (tree-path-dependent), for the main run.",
    "Seasonal-naive validation forecasts for 2023-07 to 2023-12 use pandemic months as their lag. No test forecast does."
  ],
